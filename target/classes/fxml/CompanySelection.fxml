<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.payroll.controller.CompanySelectionController"
      styleClass="root" spacing="30" alignment="TOP_CENTER">
    
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>
    
    <!-- Header -->
    <VBox alignment="CENTER" spacing="10">
        <Text styleClass="title" text="Salary Calculator"/>
        <Text styleClass="subtitle" text="Select a company or create a new one"/>
    </VBox>
    
    <!-- Company Selection Section -->
    <VBox spacing="20" maxWidth="600" prefWidth="600" alignment="CENTER">
        <VBox spacing="20" alignment="CENTER">
            <Label text="Select Existing Company" styleClass="label subtitle" style="-fx-font-size: 18px;"/>
            <ComboBox fx:id="companyComboBox" promptText="Choose a company..." 
                      maxWidth="600" prefWidth="600"
                      style="-fx-background-color: white; -fx-font-size: 16px;"/>
            <Button text="Open Company" styleClass="button" onAction="#openSelectedCompany"/>
            <Button text="Delete Company" styleClass="button secondary" onAction="#deleteSelectedCompany"/>
        </VBox>
    </VBox>
    
    <!-- Create New Company Card -->
    <VBox styleClass="company-card" maxWidth="600" prefWidth="600" 
          onMouseClicked="#showCreateCompanyDialog">
        <HBox alignment="CENTER" spacing="20">
            <Text styleClass="menu-icon" text="+"/>
            <VBox alignment="CENTER_LEFT" spacing="5">
                <Text styleClass="menu-title" text="Create New Company"/>
                <Text styleClass="menu-description" text="Start a new company database"/>
            </VBox>
        </HBox>
    </VBox>
    
</VBox>
