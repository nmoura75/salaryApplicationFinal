<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox spacing="20" styleClass="container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.payroll.controller.EmployeesMenuController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Text text="%menu.employees.title" styleClass="title"/>
        <Button fx:id="backButton" text="%action.backToMain" onAction="#goBackToMainMenu" styleClass="back-button"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label fx:id="companyNameText" styleClass="label subtitle"/>
    </HBox>

    <HBox spacing="20" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="%employee.search" prefWidth="300"/>
        <Button text="%action.addEmployee" onAction="#showAddEmployeeDialog" styleClass="primary-button"/>
        <Button text="%action.manageRemunerations" onAction="#showRemunerationManagement" styleClass="secondary-button"/>
    </HBox>

    <TableView fx:id="employeesTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="%employee.column.id" prefWidth="50"/>
            <TableColumn fx:id="nameColumn" text="%employee.column.name" prefWidth="150"/>
            <TableColumn fx:id="taxIdColumn" text="%employee.column.taxId" prefWidth="100"/>
            <TableColumn fx:id="socialSecurityIdColumn" text="%employee.column.socialSecurityId" prefWidth="120"/>
            <TableColumn fx:id="baseSalaryColumn" text="%employee.column.baseSalary" prefWidth="110" styleClass="money-cell"/>
            <TableColumn fx:id="hireDateColumn" text="%employee.column.hireDate" prefWidth="110"/>
            <TableColumn fx:id="dateOfBirthColumn" text="%employee.column.dateOfBirth" prefWidth="120"/>
            <TableColumn fx:id="dependentsColumn" text="%employee.column.dependents" prefWidth="90"/>
            <TableColumn fx:id="withholdingTableColumn" text="%employee.column.withholdingTable" prefWidth="140"/>
            <TableColumn fx:id="statusColumn" text="%employee.column.status" prefWidth="90"/>
            <TableColumn fx:id="contractTypeColumn" text="%employee.column.contractType" prefWidth="120"/>
            <TableColumn fx:id="professionColumn" text="%employee.column.profession" prefWidth="140"/>
        </columns>
    </TableView>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Button fx:id="editButton" text="%action.editEmployee" onAction="#editSelectedEmployee" styleClass="secondary-button" disable="true"/>
        <Button fx:id="deleteButton" text="%action.deleteEmployee" onAction="#deleteSelectedEmployee" styleClass="danger-button" disable="true"/>
    </HBox>

    <Text fx:id="statusText" styleClass="status-text"/>
</VBox>
