<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="salary_receipt" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    
    <field name="companyName" class="java.lang.String"/>
    <field name="companyTaxId" class="java.lang.String"/>
    <field name="companyAddress" class="java.lang.String"/>
    <field name="employeeName" class="java.lang.String"/>
    <field name="employeeTaxId" class="java.lang.String"/>
    <field name="month" class="java.lang.String"/>
    <field name="year" class="java.lang.Integer"/>
    <field name="baseSalary" class="java.math.BigDecimal"/>
    <field name="overtime" class="java.math.BigDecimal"/>
    <field name="bonus" class="java.math.BigDecimal"/>
    <field name="mealAllowance" class="java.math.BigDecimal"/>
    <field name="transportAllowance" class="java.math.BigDecimal"/>
    <field name="otherAllowances" class="java.math.BigDecimal"/>
    <field name="grossAmount" class="java.math.BigDecimal"/>
    <field name="socialSecurityContribution" class="java.math.BigDecimal"/>
    <field name="incomeTax" class="java.math.BigDecimal"/>
    <field name="netAmount" class="java.math.BigDecimal"/>
    
    <title>
        <band height="100">
            <textField>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{companyName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="25" width="555" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["Tax ID: " + $F{companyTaxId}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="45" width="555" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{companyAddress}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="70" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Salary Receipt]]></text>
            </staticText>
        </band>
    </title>
    
    <detail>
        <band height="400">
            <textField>
                <reportElement x="0" y="20" width="555" height="20"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["Employee: " + $F{employeeName} + " (Tax ID: " + $F{employeeTaxId} + ")"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="45" width="555" height="20"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["Period: " + $F{month} + " " + $F{year}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="0" y="80" width="555" height="20"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Earnings]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="20" y="105" width="200" height="15"/>
                <text><![CDATA[Base Salary:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="220" y="105" width="100" height="15"/>
                <textFieldExpression><![CDATA[$F{baseSalary}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="125" width="200" height="15"/>
                <text><![CDATA[Overtime:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="220" y="125" width="100" height="15"/>
                <textFieldExpression><![CDATA[$F{overtime}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="145" width="200" height="15"/>
                <text><![CDATA[Bonus:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="220" y="145" width="100" height="15"/>
                <textFieldExpression><![CDATA[$F{bonus}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="165" width="200" height="15"/>
                <text><![CDATA[Meal Allowance:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="220" y="165" width="100" height="15"/>
                <textFieldExpression><![CDATA[$F{mealAllowance}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="185" width="200" height="15"/>
                <text><![CDATA[Transport Allowance:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="220" y="185" width="100" height="15"/>
                <textFieldExpression><![CDATA[$F{transportAllowance}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="205" width="200" height="15"/>
                <text><![CDATA[Other Allowances:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="220" y="205" width="100" height="15"/>
                <textFieldExpression><![CDATA[$F{otherAllowances}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="0" y="240" width="555" height="20"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Deductions]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="20" y="265" width="200" height="15"/>
                <text><![CDATA[Social Security Contribution:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="220" y="265" width="100" height="15"/>
                <textFieldExpression><![CDATA[$F{socialSecurityContribution}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="285" width="200" height="15"/>
                <text><![CDATA[Income Tax:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="220" y="285" width="100" height="15"/>
                <textFieldExpression><![CDATA[$F{incomeTax}]]></textFieldExpression>
            </textField>
            
            <line>
                <reportElement x="0" y="320" width="555" height="1"/>
            </line>
            
            <staticText>
                <reportElement x="20" y="330" width="200" height="20"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Gross Amount:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="220" y="330" width="100" height="20"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{grossAmount}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="355" width="200" height="20"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Net Amount:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="220" y="355" width="100" height="20"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{netAmount}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <pageFooter>
        <band height="50">
            <textField>
                <reportElement x="0" y="30" width="555" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport> 